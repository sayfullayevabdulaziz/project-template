            "type": "string"
          },
          "created_by_id": {
            "format": "uuid",
            "title": "Created By Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_published": {
            "title": "Is Published",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "is_published",
          "created_by_id",
          "created_at",
          "updated_at"
        ],
        "title": "ItemAdmin",
        "type": "object"
      },
      "ItemAdminPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemAdmin"
            },
